# Copiá a .env.local y completá los valores

DATABASE_URL="mariadb://USER:PASSWORD@HOST:3306/DB_NAME"

# Auth
JWT_SECRET="change-me-in-local-dev"

# App URL (puerto local de la tienda)
NEXT_PUBLIC_BASE_URL="http://localhost:3002"

# Email (opcional en local)
RESEND_API_KEY=""
EMAIL_FROM="Nave Cine Metro <onboarding@resend.dev>"

# Pagos n1co (opcional en local)
N1CO_ENV="sandbox"
N1CO_CLIENT_ID=""
N1CO_CLIENT_SECRET=""

# S3 uploads (si faltan, las imágenes se guardan en public/uploads)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""
S3_BASE_URL=""

# Seed admin (opcional)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_NAME=""
SEED_ADMIN_PASSWORD=""
